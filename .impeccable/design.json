    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action on a card or dialog step (Change plan, Keep subscription, Upgrade).",
      "html": "<button class=\"ds-btn ds-btn-primary\">Change plan</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 20px;border:1px solid transparent;border-radius:6px;font-family:var(--font-body,'Open Sans',sans-serif);font-size:14px;font-weight:600;line-height:1.2;cursor:pointer;transition:background-color 150ms cubic-bezier(0.22,1,0.36,1),border-color 150ms cubic-bezier(0.22,1,0.36,1),color 150ms cubic-bezier(0.22,1,0.36,1)}.ds-btn:focus-visible{outline:2px solid var(--color-interactive-primary,#00735f);outline-offset:2px}.ds-btn-primary{background:var(--color-interactive-primary,#00735f);color:var(--color-base-light,#fff)}.ds-btn-primary:hover{background:var(--color-interactive-control,#004d3f)}.ds-btn-primary:active{box-shadow:inset 0 2px 0 rgb(0 0 0 / 0.14)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined green action of lesser weight (Update payment method, Contact sales).",
      "html": "<button class=\"ds-btn ds-btn-secondary\">Update</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 20px;border:1px solid transparent;border-radius:6px;font-family:var(--font-body,'Open Sans',sans-serif);font-size:14px;font-weight:600;line-height:1.2;cursor:pointer;transition:background-color 150ms cubic-bezier(0.22,1,0.36,1),border-color 150ms cubic-bezier(0.22,1,0.36,1),color 150ms cubic-bezier(0.22,1,0.36,1)}.ds-btn:focus-visible{outline:2px solid var(--color-interactive-primary,#00735f);outline-offset:2px}.ds-btn-secondary{background:var(--color-base-light,#fff);border-color:var(--color-interactive-primary,#00735f);color:var(--color-interactive-primary,#00735f)}.ds-btn-secondary:hover{background:var(--color-interactive-accent,#e5f1e8)}"
    },
    {
      "name": "Current Plan Button",
      "kind": "button",
      "refersTo": "button-current",
      "description": "Inert tinted state marking the plan the user already has.",
      "html": "<button class=\"ds-btn ds-btn-current\" aria-disabled=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg> Current plan</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 20px;border:1px solid transparent;border-radius:6px;font-family:var(--font-body,'Open Sans',sans-serif);font-size:14px;font-weight:600;line-height:1.2;cursor:pointer;transition:background-color 150ms cubic-bezier(0.22,1,0.36,1),border-color 150ms cubic-bezier(0.22,1,0.36,1),color 150ms cubic-bezier(0.22,1,0.36,1)}.ds-btn:focus-visible{outline:2px solid var(--color-interactive-primary,#00735f);outline-offset:2px}.ds-btn-current{background:var(--color-interactive-selected,#edf5ef);border-color:var(--color-border-accent,#8fcaa9);color:var(--color-interactive-control,#004d3f);cursor:default}"
